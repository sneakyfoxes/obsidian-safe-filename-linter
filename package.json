{
	"name": "safe-filename-linter",
	"version": "1.4.0",
	"description": "Obsidian app plugin to lint filenames for invalid or troublesome characters",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "sneakyfoxes",
	"license": "gpl-3.0",
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.28.2",
		"eslint-config-prettier": "^9.0.0",
		"globals": "^17.13.0",
		"obsidian": "latest",
		"prettier": "^3.0.1",
		"tslib": "2.4.0",
		"typescript": "4.8.4"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
